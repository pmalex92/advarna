---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="404 | ADVARNA" description="Page not found." canonical="/404">
  <main class="min-h-screen grid place-items-center bg-[#f8fafc] px-4">
    <div class="text-center">
      <p class="text-[#54b9ff] font-semibold mb-2">404</p>
      <h1 class="text-4xl font-bold text-[#2c3e50] mb-4">Page Not Found</h1>
      <p class="text-gray-600 mb-8">The page you are looking for does not exist.</p>
      <a href="/" class="inline-flex items-center gap-2 px-6 py-3 bg-[#54b9ff] text-white font-semibold rounded-lg transition-all duration-300 hover:bg-[#3aa8f5]">Return Home</a>
    </div>
  </main>
</BaseLayout>
